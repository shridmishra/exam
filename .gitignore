# ==============================================================================
# Exam Intelligence & PYQ Platform (.gitignore)
# ==============================================================================

# Timetable Raw PDFs & OCR Scratch Files (Source scripts & timetable.html are tracked)
*Timetable*.pdf
*timetable*.pdf
tools/timetable/*.pdf
tools/timetable/*.txt
tools/timetable/*.swift
ocr_*.txt
ocr_*.swift
local/

# Python runtime & bytecode
__pycache__/
*.py[cod]
*$py.class
*.bak
*.py.bak
.pytest_cache/

# macOS / OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local convenience symlinks (root only)
/geotech-2

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary scratch & intermediate working files
scratch/
tmp/
*.tmp
