import json
import re
import compile_data

# Load canonical topics
with open("canonical_data.json", "r", encoding="utf-8") as f:
    canonical_topics = json.load(f)

raw_questions = compile_data.questions

def format_solution(html):
    if not html:
        return ""
    html = html.replace("<br>\n<br>", "<br>").replace("<br><br>", "<br>")
    
    parts = re.split(r'<br>\s*(?=<strong>)', html)
    formatted = []
    for p in parts:
        p = p.strip()
        if not p:
            continue
        p = re.sub(r'<em>Example:?</em>', '<span class="example-tag">Example</span>', p)
        
        # Detect numbered/bullet lists inside this step block
        lines = [line.strip() for line in re.split(r'<br\s*/?>|\n', p) if line.strip()]
        if len(lines) > 1 and any(re.match(r'^(\d+\.|[a-z]\)|[•\-\*])\s+', l) for l in lines):
            output_parts = []
            in_list = False
            for l in lines:
                m = re.match(r'^(\d+\.|[a-z]\)|[•\-\*])\s+(.*)', l)
                if m:
                    if not in_list:
                        output_parts.append('<ul class="sol-list">')
                        in_list = True
                    output_parts.append(f'<li><span class="sol-item-num">{m.group(1)}</span> {m.group(2)}</li>')
                else:
                    if in_list:
                        output_parts.append('</ul>')
                        in_list = False
                    output_parts.append(f'<div class="sol-text-block">{l}</div>')
            if in_list:
                output_parts.append('</ul>')
            step_html = "".join(output_parts)
        else:
            step_html = "<br>".join(lines)
            
        formatted.append(f'<div class="sol-step">{step_html}</div>')
    return "".join(formatted)

for q in raw_questions:
    q['formatted_solution'] = format_solution(q['solution'])

for c in canonical_topics:
    c['formatted_solution'] = format_solution(c['master_solution'])

canonical_json_str = json.dumps(canonical_topics).replace("</script>", "<\\/script>")
raw_json_str = json.dumps(raw_questions).replace("</script>", "<\\/script>")

