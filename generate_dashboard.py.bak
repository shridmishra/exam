            transition: box-shadow 0.15s ease;
        }}

        .search-input:focus {{
            box-shadow: 0 0 0 2px var(--secondary-hover);
        }}

        .search-icon {{
            position: absolute;
            left: 0.65rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted-foreground);
            pointer-events: none;
        }}

        .filter-groups-wrapper {{
            display: flex;
