            white-space: nowrap;
        }}

        .filter-pill-btn:hover {{ color: var(--foreground); background-color: var(--secondary-hover); }}
        .filter-pill-btn.active {{
            background-color: var(--primary);
            color: var(--primary-foreground);
            font-weight: 600;
        }}

        .control-panel-counter {{
            margin-left: auto;
        }}

        .match-counter-badge {{
            display: inline-flex;
            align-items: center;
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--muted-foreground);
            background-color: var(--secondary);
            padding: 0.2rem 0.55rem;
            border-radius: var(--radius-full);
            white-space: nowrap;
        }}

        /* ----------------------------------------------------
           QUESTIONS ENGINE: CLICK-TO-OPEN CARD (NO TOGGLE BUTTON)
           CONSTRAINED OPTIMAL READING MEASURE (NO RUNAWAY WIDE LINES)
           ---------------------------------------------------- */
        .questions-list-wrapper {{
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
        }}

        .q-item {{
            background-color: var(--card);
            border-radius: var(--radius-lg);
            padding: 1.6rem 2rem;
            box-shadow: var(--shadow-sm);
            cursor: pointer;
            user-select: none;
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
        }}

        .q-item:hover {{
            box-shadow: var(--shadow-md);
            background-color: var(--card);
        }}

        .q-item-header {{
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 0.5rem;
            flex-wrap: wrap;
        }}

        .q-item-badges {{
            display: flex;
            align-items: center;
            gap: 0.4rem;
            flex-wrap: wrap;
        }}

        .q-item-side-meta {{
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-left: auto;
            color: var(--muted-foreground);
        }}

        .chevron-icon {{
            transition: transform 0.2s ease;
            color: var(--muted-foreground);
        }}

        /* WHEN ANSWER IS OPEN:
           1. HIDE/MUTE BADGE COLORS
           2. ROTATE CHEVRON ICON
        */
        .q-item.is-open .badge {{
            background-color: var(--secondary) !important;
            color: var(--muted-foreground) !important;
        }}

        .q-item.is-open .chevron-icon {{
            transform: rotate(180deg);
            color: var(--foreground);
        }}

        .q-item-title {{
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--foreground);
            line-height: 1.35;
            margin-bottom: 0.5rem;
            max-width: 920px; /* Constrained readable measure */
        }}

        .q-item-statement {{
            font-size: 0.984375rem;
            line-height: 1.65;
            color: var(--foreground);
            max-width: 900px; /* Constrained readable measure */
        }}

        /* READABLE, CONSTRAINED ANSWER UI (NO RUNAWAY WIDE LINES) */
        .q-solution-content {{
            display: none;
            padding-top: 1.25rem;
            margin-top: 1rem;
            cursor: default;
            user-select: text; /* Allow text selection inside open answer */
        }}

        .q-solution-content.open {{
            display: block;
        }}

        .solution-body {{
            max-width: 900px; /* OPTIMAL READING MEASURE: 65-80 CHARACTERS PER LINE */
            font-size: 0.96875rem;
            line-height: 1.75;
            color: var(--foreground);
        }}

        .sol-step {{
            max-width: 900px;
            margin-bottom: 1.25rem;
            line-height: 1.75;
            font-size: 0.953125rem;
            color: var(--foreground);
        }}

        .sol-step:last-child {{
            margin-bottom: 0;
        }}

        .sol-step strong {{
            font-size: 1.0625rem;
            font-weight: 600;
            color: var(--foreground);
            display: inline-block;
            margin-bottom: 0.25rem;
        }}

        .sol-step code {{
            display: block;
            max-width: 860px;
            background-color: var(--secondary);
            padding: 0.65rem 0.95rem;
            border-radius: var(--radius-md);
            font-family: var(--font-family-mono);
            font-size: 0.9375rem;
            margin: 0.75rem 0;
            overflow-x: auto;
            line-height: 1.55;
            color: var(--foreground);
        }}

        .example-tag {{
            display: inline-block;
            font-size: 0.71875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            background-color: var(--secondary);
            color: var(--muted-foreground);
            padding: 0.15rem 0.45rem;
            border-radius: var(--radius-sm);
            margin: 0 0.35rem;
            vertical-align: middle;
        }}

        .empty-results {{
            text-align: center;
            padding: 3.5rem 1.5rem;
            background-color: var(--card);
            border-radius: var(--radius-lg);
            color: var(--muted-foreground);
            box-shadow: var(--shadow-sm);
        }}

        /* Overview Stat Grid */
        .overview-grid {{
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.25rem;
            margin-bottom: 1.75rem;
        }}

        .overview-card {{
            background-color: var(--card);
            padding: 1.5rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }}
    </style>
</head>
<body>

    <!-- STICKY HEADER NAVBAR (WITH BRAND BADGE & BADGE VIEW LINKS) -->
    <header class="header">
        <div class="container nav">
            <div class="brand" onclick="switchPageView('questions')" title="Geotechnical Engineering - II">
                <span class="brand-badge">CE 41007</span>
                <span class="brand-title">Geotechnical Engineering - II</span>
            </div>

            <!-- Nav links with badge view -->
            <ul class="nav-links">
                <li>
                    <button class="nav-link-btn active" data-view="questions" onclick="switchPageView('questions')">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                        Question Bank
                        <span class="nav-badge">78 PYQs</span>
                    </button>
                </li>
                <li>
                    <button class="nav-link-btn" data-view="repeated" onclick="switchPageView('repeated')">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                        Most Repeated
                        <span class="nav-badge">Top 8</span>
                    </button>
                </li>
                <li>
                    <button class="nav-link-btn" data-view="syllabus" onclick="switchPageView('syllabus')">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                        Syllabus Breakdown
                        <span class="nav-badge">5 Units</span>
                    </button>
                </li>
                <li>
                    <button class="nav-link-btn" data-view="formulas" onclick="switchPageView('formulas')">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                        Formulas
                        <span class="nav-badge">Cheat-Sheet</span>
                    </button>
                </li>
                <li>
                    <button class="nav-link-btn" data-view="overview" onclick="switchPageView('overview')">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Overview
                        <span class="nav-badge">78 PYQs</span>
                    </button>
                </li>
                <li>
                    <a href="timetable.html" class="nav-link-btn nav-link-timetable" title="View Exam Timetable">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        Timetable
                    </a>
                </li>
            </ul>

            <div class="nav-actions">
                <button class="theme-toggle-btn" id="themeToggle" aria-label="Toggle Theme" title="Toggle Light/Dark Theme">
                    <svg class="icon" id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <div class="container">

        <!-- ====================================================
             PAGE VIEW 1: QUESTIONS & SOLUTIONS ENGINE (DEFAULT)
             ==================================================== -->
        <div class="app-page-view active" id="view-questions">
            <div class="page-header-row">
                <span class="card-overline">Study Repository &bull; Complete Exam Papers Engine</span>
                <h1 class="page-title">Questions &amp; Verified Solutions</h1>
            </div>

            <!-- Compact, Space-Efficient Control Panel -->
            <div class="control-panel">
                <div class="control-panel-row control-panel-top">
                    <div class="view-tabs" role="tablist">
                        <button class="view-tab-btn active" id="tabRaw" onclick="switchViewMode('raw')" title="View all 78 questions from 2024, 2023, and 2022 exam papers">
                            <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            Complete Exam Papers (78 Questions)
                        </button>
                        <button class="view-tab-btn" id="tabDedup" onclick="switchViewMode('dedup')" title="View 36 deduplicated core syllabus topics">
                            <svg class="icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                            Deduplicated Study Core (36 Topics)
                        </button>
                    </div>

                    <div class="search-box-wrapper">
                        <svg class="icon icon-sm search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" class="search-input" id="searchInput" placeholder="Search topics, questions, formulas... (Press '/')" aria-label="Search questions">
                    </div>
                </div>

                <div class="control-panel-row control-panel-bottom">
                    <div class="filter-groups-wrapper">
                        <div class="filter-subgroup">
                            <span class="filter-group-label">Unit:</span>
                            <div id="unitFilters" class="filter-pills-row">
                                <button class="filter-pill-btn active" data-unit="all">All</button>
                                <button class="filter-pill-btn" data-unit="1">Unit 1</button>
                                <button class="filter-pill-btn" data-unit="2">Unit 2</button>
                                <button class="filter-pill-btn" data-unit="3">Unit 3</button>
                                <button class="filter-pill-btn" data-unit="4">Unit 4</button>
                                <button class="filter-pill-btn" data-unit="5">Unit 5</button>
                            </div>
                        </div>

                        <div class="filter-divider" aria-hidden="true"></div>

                        <div class="filter-subgroup">
                            <span class="filter-group-label">Type:</span>
                            <div id="typeFilters" class="filter-pills-row">
                                <button class="filter-pill-btn active" data-type="all">All</button>
                                <button class="filter-pill-btn" data-type="Theory">Theory</button>
                                <button class="filter-pill-btn" data-type="Numerical">Numerical</button>
                                <button class="filter-pill-btn" data-type="Derivation">Derivation</button>
                            </div>
                        </div>
                    </div>

                    <div class="control-panel-counter">
                        <span class="match-counter-badge" id="matchCounter">78 of 78 matched</span>
                    </div>
                </div>
            </div>

            <!-- Dynamic Question List Container -->
            <div class="questions-list-wrapper" id="questionsContainer">
                <!-- Rendered dynamically by JavaScript -->
            </div>
        </div>

        <!-- ====================================================
             PAGE VIEW 2: MOST REPEATED (TOP 8 GUARANTEED TOPICS)
             ==================================================== -->
        <div class="app-page-view" id="view-repeated">
            <div class="page-header-row">
                <span class="card-overline">Strategic Prioritization &bull; 48+ Marks</span>
                <h1 class="page-title">Top 8 Guaranteed High-Yield Concepts</h1>
            </div>

            <div class="table-responsive-wrapper">
                <table class="master-data-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Frequency</th>
                            <th>Core Recurring Question / Concept</th>
                            <th style="width: 100px;">Unit</th>
                            <th>Past Exam Occurrences</th>
                            <th style="width: 100px;">Typical Marks</th>
                            <th>Key Solution Strategy</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="badge badge-subtle">100% (3/3 Papers)</span></td>
                            <td><strong>Standard Penetration Test (SPT) &amp; Corrections</strong></td>
                            <td><span class="badge badge-unit-5">Unit 5</span></td>
                            <td>
                                <ul class="table-list table-list-compact">
                                    <li>2024 Q5(e) OR (7M)</li>
                                    <li>2023 Q5(c) OR (7M)</li>
                                    <li>2022 Q5(d) (7M)</li>
                                </ul>
                            </td>
                            <td>7 Marks</td>
                            <td>
                                <ul class="table-list">
                                    <li>Apply overburden correction <span class="formula-chip-sm">N'</span> first based on effective overburden pressure <span class="formula-chip-sm">&sigma;'<sub>v</sub></span></li>
                                    <li>If <span class="formula-chip-sm">N' &gt; 15</span> under submerged fine sand or silt, apply dilatancy correction: <span class="formula-chip-sm">N'' = 15 + 0.5(N' - 15)</span></li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-subtle">100% (3/3 Papers)</span></td>
                            <td><strong>9-Pile Group Safe Load in Soft Clay Numerical</strong></td>
                            <td><span class="badge badge-unit-4">Unit 4</span></td>
                            <td>
                                <ul class="table-list table-list-compact">
                                    <li>2024 Q4(d) (7M)</li>
                                    <li>2023 Q4(c) (6M)</li>
                                    <li>2022 Q4(e) OR (7M)</li>
                                </ul>
                            </td>
                            <td>7 Marks</td>
                            <td>
                                <ul class="table-list">
                                    <li>Calculate block capacity <span class="formula-chip-sm">Q<sub>ug</sub> = 9 c<sub>u</sub> B&sup2; + 4 B L &alpha; c<sub>u</sub></span></li>
                                    <li>Calculate individual pile sum <span class="formula-chip-sm">n &middot; Q<sub>ui</sub> = n(9 c<sub>u</sub> A<sub>b</sub> + &alpha; c<sub>u</sub> A<sub>s</sub>)</span></li>
                                    <li>Take the minimum capacity and divide by factor of safety <span class="formula-chip-sm">FS = 2.5</span> (&rArr; 1133.7 kN)</li>
                                    <li><span class="note-highlight note-highlight-green">Verbatim identical in 2024 &amp; 2022!</span></li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-subtle">100% (3/3 Papers)</span></td>
                            <td><strong>Water Table Effect on Ultimate &amp; Safe Bearing Capacity</strong></td>
                            <td><span class="badge badge-unit-3">Unit 3</span></td>
                            <td>
                                <ul class="table-list table-list-compact">
                                    <li>2024 Q3(e) OR (7M)</li>
                                    <li>2023 Q2(c) (6M)</li>
                                    <li>2022 Q3(d) (7M)</li>
                                </ul>
                            </td>
                            <td>6-7 Marks</td>
                            <td>
                                <ul class="table-list">
                                    <li>Evaluate water table depth relative to footing depth <span class="formula-chip-sm">D<sub>f</sub></span> and width <span class="formula-chip-sm">B</span></li>
                                    <li>When WT rises from depth <span class="formula-chip-sm">(D<sub>f</sub> + B)</span> to ground level, surcharge unit weight drops to <span class="formula-chip-sm">&gamma;<sub>sub</sub></span></li>
                                    <li>Correction factors <span class="formula-chip-sm">R<sub>w1</sub> = R<sub>w2</sub> = 0.5</span> produce <span class="note-highlight">~50% reduction</span> in safe bearing capacity (<span class="formula-chip-sm">q<sub>safe</sub></span>)</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-subtle">67% (2/3 Papers)</span></td>
                            <td><strong>Gravity Retaining Wall Coulomb Earth Thrust (12m &amp; 15m)</strong></td>
                            <td><span class="badge badge-unit-1">Unit 1</span></td>
                            <td>
                                <ul class="table-list table-list-compact">
                                    <li>2024 Q1(d) (7M)</li>
                                    <li>2022 Q1(d) (7M)</li>
                                </ul>
                            </td>
                            <td>7 Marks</td>
                            <td>
                                <ul class="table-list">
                                    <li>Compute Coulomb coefficients <span class="formula-chip-sm">K<sub>a</sub></span> and <span class="formula-chip-sm">K<sub>p</sub></span> with <span class="formula-chip-sm">&phi; = 30&deg;, &delta; = 20&deg;</span></li>
                                    <li>Compute total active / passive thrust: <span class="formula-chip-sm">P = 0.5 &gamma; H&sup2; K</span></li>
                                    <li>Point of action: at <span class="formula-chip-sm">H/3</span> above base, inclined at angle <span class="formula-chip-sm">&delta; = 20&deg;</span> to wall normal</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-subtle">100% (3/3 Papers)</span></td>
                            <td><strong>Modes of Shear Failure (General, Local, Punching)</strong></td>
                            <td><span class="badge badge-unit-2">Unit 2</span></td>
                            <td>
                                <ul class="table-list table-list-compact">
                                    <li>2024 Q2(b) (2M)</li>
                                    <li>2023 Q2(b) i (3M)</li>
                                    <li>2024 Q3(c) (3M)</li>
                                </ul>
                            </td>
                            <td>3 Marks</td>
                            <td>
                                <ul class="table-list">
                                    <li><strong>Dense Sand (<span class="formula-chip-sm">&phi; &gt; 36&deg;</span>):</strong> General shear failure, distinct peak load, well-defined slip surfaces, prominent ground heaving</li>
                                    <li><strong>Loose Sand (<span class="formula-chip-sm">&phi; &lt; 28&deg;</span>):</strong> Punching / local shear, no peak, large progressive settlement without surface heave</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-subtle">100% (3/3 Papers)</span></td>
                            <td><strong>Triaxial Test Drainage Modes: UU, CU, and CD Selection</strong></td>
                            <td><span class="badge badge-unit-2">Unit 2</span></td>
                            <td>
                                <ul class="table-list table-list-compact">
                                    <li>2024 Q2(c) (3M)</li>
                                    <li>2023 Q3(b) iii (3M)</li>
                                    <li>2022 Q2(b) (2M)</li>
                                </ul>
                            </td>
                            <td>3 Marks</td>
                            <td>
                                <ul class="table-list">
                                    <li><strong>UU (Unconsolidated Undrained):</strong> Rapid construction over saturated clay (no pore water dissipation permitted)</li>
                                    <li><strong>CU (Consolidated Undrained):</strong> Sudden reservoir drawdown in dam slopes (with pore pressure measurement)</li>
                                    <li><strong>CD (Consolidated Drained):</strong> Long-term steady-state drained stability of slopes, foundations, and retaining walls</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-subtle">100% (3/3 Papers)</span></td>
                            <td><strong>Soil Sampler Design Criteria (A<sub>r</sub>, C<sub>i</sub>, C<sub>o</sub>)</strong></td>
                            <td><span class="badge badge-unit-5">Unit 5</span></td>
                            <td>
                                <ul class="table-list table-list-compact">
                                    <li>2024 Q5(c) (3M)</li>
                                    <li>2022 Q5(c) (3M)</li>
                                </ul>
                            </td>
                            <td>3 Marks</td>
                            <td>
                                <ul class="table-list">
                                    <li><strong>Area Ratio (<span class="formula-chip-sm">A<sub>r</sub></span>):</strong> &le; 10&ndash;12% to minimize soil displacement and shearing (thin-walled tube)</li>
                                    <li><strong>Inside Clearance (<span class="formula-chip-sm">C<sub>i</sub></span>):</strong> 1&ndash;3% to allow elastic expansion and eliminate internal wall friction</li>
                                    <li><strong>Outside Clearance (<span class="formula-chip-sm">C<sub>o</sub></span>):</strong> 0&ndash;2% to reduce driving drag on sample barrel</li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-subtle">67% (2/3 Papers)</span></td>
                            <td><strong>Rebhann's Graphical Construction for Active Thrust</strong></td>
                            <td><span class="badge badge-unit-1">Unit 1</span></td>
                            <td>
                                <ul class="table-list table-list-compact">
                                    <li>2023 Q1(c) OR (6M)</li>
                                    <li>2022 Q1(e) OR (7M)</li>
                                </ul>
                            </td>
                            <td>6-7 Marks</td>
                            <td>
                                <ul class="table-list">
                                    <li>Draw ground surface, <span class="formula-chip-sm">&phi;</span>-line, and <span class="formula-chip-sm">&psi;</span>-line radiating from wall heel</li>
                                    <li>Construct semi-circle on intercept line to locate the critical rupture surface point</li>
                                    <li>Erect perpendicular chord to determine the maximum active earth pressure triangle</li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ====================================================
             PAGE VIEW 3: SYLLABUS BREAKDOWN (5 UNITS)
             ==================================================== -->
        <div class="app-page-view" id="view-syllabus">
            <div class="page-header-row">
                <span class="card-overline">Course Structure &bull; 14 Marks per Unit</span>
                <h1 class="page-title">5-Unit Structure &amp; Exam Weightage</h1>
            </div>

            <div class="table-responsive-wrapper">
                <table class="master-data-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Unit</th>
                            <th style="width: 240px;">Subject Domain</th>
                            <th>Most Frequent Recurring Exam Questions</th>
                            <th>Key Governing Formulas</th>
                            <th style="width: 110px; text-align: right;">Weightage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="badge badge-unit-1">Unit 1</span></td>
                            <td>
                                <strong>Lateral Earth Pressure &amp; Retaining Walls</strong>
                                <ul class="table-list table-list-compact" style="margin-top: 0.35rem;">
                                    <li>At-rest, Rankine &amp; Coulomb wedge theories</li>
                                    <li>Gravity and cantilever retaining wall stability</li>
                                </ul>
                            </td>
                            <td>
                                <ul class="table-list">
                                    <li>Gravity Retaining Wall Coulomb Active &amp; Passive Thrust (12m / 15m)</li>
                                    <li>Rebhann's graphical construction &amp; Poncelet triangle proof</li>
                                    <li>Tension crack depth in cohesive soil (<span class="formula-chip-sm">z<sub>c</sub> = 2c / &gamma;&radic;K<sub>a</sub></span>)</li>
                                    <li>Surcharged &amp; battered backfill pressure distribution</li>
                                </ul>
                            </td>
                            <td>
                                <span class="formula-chip">K<sub>a</sub> = (1-sin&phi;)/(1+sin&phi;)</span>
                                <span class="formula-chip">z<sub>c</sub> = 2c / (&gamma;&radic;K<sub>a</sub>)</span>
                                <span class="formula-chip">K<sub>0</sub> = &mu; / (1-&mu;)</span>
                            </td>
                            <td style="text-align: right; font-weight: 600;">14 Marks</td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-unit-2">Unit 2</span></td>
                            <td>
                                <strong>Shear Strength &amp; Slope Stability</strong>
                                <ul class="table-list table-list-compact" style="margin-top: 0.35rem;">
                                    <li>Mohr-Coulomb failure &amp; triaxial testing modes</li>
                                    <li>Infinite &amp; finite slope stability with steady seepage</li>
                                </ul>
                            </td>
                            <td>
                                <ul class="table-list">
                                    <li>Triaxial drainage modes (UU, CU, CD) selection criteria</li>
                                    <li>Area correction (<span class="formula-chip-sm">A = A<sub>0</sub> / (1-&epsilon;)</span>) &amp; Mohr-Coulomb parameters (<span class="formula-chip-sm">c, &phi;</span>)</li>
                                    <li>Modes of shear failure &amp; load-settlement characteristics</li>
                                    <li>Infinite slope stability with steady seepage parallel to face</li>
                                </ul>
                            </td>
                            <td>
                                <span class="formula-chip">&sigma;'₁ = &sigma;'₃ N<sub>&phi;</sub> + 2c'&radic;N<sub>&phi;</sub></span>
                                <span class="formula-chip">A = A<sub>0</sub> / (1-&epsilon;)</span>
                                <span class="formula-chip">FS = (c' + &gamma;' z cos&sup2;&beta; tan&phi;') / (&gamma;<sub>sat</sub> z sin&beta; cos&beta;)</span>
                            </td>
                            <td style="text-align: right; font-weight: 600;">14 Marks</td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-unit-3">Unit 3</span></td>
                            <td>
                                <strong>Shallow Foundations &amp; Bearing Capacity</strong>
                                <ul class="table-list table-list-compact" style="margin-top: 0.35rem;">
                                    <li>Terzaghi &amp; IS bearing capacity equations</li>
                                    <li>Water table corrections &amp; plate load test</li>
                                </ul>
                            </td>
                            <td>
                                <ul class="table-list">
                                    <li>Water table effect on safe bearing capacity (<span class="note-highlight note-highlight-green">100% Guaranteed 3/3 papers</span>)</li>
                                    <li>Terzaghi ultimate bearing capacity theory &amp; core assumptions</li>
                                    <li>Plate load test &amp; Housel's two-plate equation (<span class="formula-chip-sm">Q = Am + Pn</span>)</li>
                                    <li>Square, circular, and continuous strip footing sizing</li>
                                </ul>
                            </td>
                            <td>
                                <span class="formula-chip">q<sub>ult</sub> = c N<sub>c</sub> + q N<sub>q</sub> + 0.5 &gamma; B N<sub>&gamma;</sub></span>
                                <span class="formula-chip">R<sub>w1</sub>, R<sub>w2</sub> = 0.5(1 + z<sub>w</sub>/d)</span>
                                <span class="formula-chip">S<sub>i</sub> = q B (1-&mu;&sup2;)/E &middot; I<sub>f</sub></span>
                            </td>
                            <td style="text-align: right; font-weight: 600;">14 Marks</td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-unit-4">Unit 4</span></td>
                            <td>
                                <strong>Deep Foundations (Piles &amp; Caissons)</strong>
                                <ul class="table-list table-list-compact" style="margin-top: 0.35rem;">
                                    <li>Single pile &amp; group capacity in clay and sand</li>
                                    <li>Under-reamed piles &amp; open caissons</li>
                                </ul>
                            </td>
                            <td>
                                <ul class="table-list">
                                    <li>9-Pile group safe load in soft clay (<span class="note-highlight note-highlight-green">Verbatim repeat 2024 &amp; 2022</span>)</li>
                                    <li>Pile group efficiency &amp; block failure vs individual pile sum</li>
                                    <li>Optimum pile spacing derivation (<span class="formula-chip-sm">s = d + 2d/&pi;&alpha;</span>)</li>
                                    <li>Under-reamed piles &amp; open caisson sinking methods</li>
                                </ul>
                            </td>
                            <td>
                                <span class="formula-chip">Q<sub>ug</sub> = 9 c<sub>u</sub> B&sup2; + 4 B L &alpha; c<sub>u</sub></span>
                                <span class="formula-chip">Q<sub>ui</sub> = n &middot; (9 c<sub>u</sub> A<sub>b</sub> + &alpha; c<sub>u</sub> A<sub>s</sub>)</span>
                                <span class="formula-chip">&eta; = 1 - (&theta;/90&deg;)[(n-1)m + (m-1)n]/(mn)</span>
                            </td>
                            <td style="text-align: right; font-weight: 600;">14 Marks</td>
                        </tr>
                        <tr>
                            <td><span class="badge badge-unit-5">Unit 5</span></td>
                            <td>
                                <strong>Subsoil Exploration &amp; Testing</strong>
                                <ul class="table-list table-list-compact" style="margin-top: 0.35rem;">
                                    <li>Standard Penetration Test (SPT) corrections</li>
                                    <li>Soil sampler design &amp; rock core drilling (RQD)</li>
                                </ul>
                            </td>
                            <td>
                                <ul class="table-list">
                                    <li>Standard Penetration Test (SPT) overburden &amp; dilatancy corrections (<span class="note-highlight note-highlight-green">100% Guaranteed 3/3 papers</span>)</li>
                                    <li>Soil sampler design criteria (Area ratio <span class="formula-chip-sm">A<sub>r</sub> &le; 10%</span>, <span class="formula-chip-sm">C<sub>i</sub></span>, <span class="formula-chip-sm">C<sub>o</sub></span>)</li>
                                    <li>Borelog preparation &amp; standard subsoil stratification profiles</li>
                                    <li>Core drilling in rock: RQD &amp; TCR determination and quality rating</li>
                                </ul>
                            </td>
                            <td>
                                <span class="formula-chip">N' = N &middot; 350 / (&sigma;'<sub>v</sub> + 70)</span>
                                <span class="formula-chip">N'' = 15 + 0.5(N' - 15)</span>
                                <span class="formula-chip">A<sub>r</sub> = (D&sup2;<sub>ext</sub> - D&sup2;<sub>int</sub>)/D&sup2;<sub>int</sub> &times; 100%</span>
                            </td>
                            <td style="text-align: right; font-weight: 600;">14 Marks</td>
                        </tr>
                    </tbody>
